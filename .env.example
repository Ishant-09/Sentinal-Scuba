# GuildUp Environment Configuration

# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://guildup:guildup_password@localhost:5432/guildup_db?schema=public"

# Cache & Real-Time (Redis 7)
REDIS_URL="redis://localhost:6379"

# Authentication Secrets (minimum 32 characters in production)
JWT_SECRET="dev_super_secret_jwt_access_token_key_change_in_prod_12345"
REFRESH_SECRET="dev_super_secret_jwt_refresh_token_key_change_in_prod_67890"

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000"

# LiveKit Audio / Video & Screen Share
LIVEKIT_URL="http://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secretdevkey12345678901234567890"

# Mentor Astra NPC AI (Optional LLM Integration)
ASTRA_LLM_ENABLED="false"
ASTRA_OPENAI_API_KEY=""
